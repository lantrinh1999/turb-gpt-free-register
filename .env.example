# Copy to .env and fill values. Never commit .env
#   cp .env.example .env

# All WebUI-editable settings use .env to override the config/*.py defaults.

# ---- WebUI Authorization ----
# WebUI login authorization code; saved only in .env so it does not appear on the process command line
WEBUI_AUTH_CODE="123456"
# Optional: Session Cookie signing key; when empty it is derived from the fixed authorization code; changing the authorization code invalidates existing logins
WEBUI_SESSION_SECRET="123456"


# ---- Feature Switches ----
# Enable Codex OAuth: automatically run Codex authorization after successful registration (fresh session + SMS code receiving), save to codex-email.json
ENABLE_CODEX_AUTO="False"

# ---- Registration Method ----
# Registration driver: protocol=pure protocol; roxy=RoxyBrowser; cloak=CloakBrowser;browser_use=Browser Use Cloud+Playwright
REGISTRATION_DRIVER="roxy"
PROTOCOL_REUSE_FINGERPRINT_BY_EMAIL="false"
GENERIC_API_PROXY=""

# ---- CloakBrowser ----
# Cloak headless: True=run headless; False=show the browser window
CLOAK_HEADLESS="False"
# Cloak humanized behavior: enable CloakBrowser humanize mouse/keyboard/scroll behavior
CLOAK_HUMANIZE="True"
# Cloak locate by exit: auto-match timezone/language/WebRTC IP to the current exit IP; supports explicit proxy, system proxy/VPN
CLOAK_GEOIP="True"
# Cloak locale: leave empty for auto; for Japan use ja-JP, for the US en-US
CLOAK_LOCALE=""
# Cloak timezone: leave empty for auto; for Japan use Asia/Tokyo, for the US America/Los_Angeles
CLOAK_TIMEZONE=""
# Cloak use proxy: pass the proxy given to this project or taken from the proxy pool to CloakBrowser
CLOAK_USE_PROXY="False"
# Cloak License: Pro license; leave empty to use the free binary
CLOAK_LICENSE_KEY=""
# Cloak fingerprint seed: leave empty for random each time; a fixed value keeps the same fingerprint
CLOAK_FINGERPRINT_SEED=""
# Cloak user directory: leave empty to use a temporary context; set a path to persist cookies/cache
CLOAK_USER_DATA_DIR=""
# Cloak timeout: page and element wait timeout, in seconds
CLOAK_SELENIUM_TIMEOUT="90"
# Keep Cloak browser: enable when debugging, do not close automatically after the task ends
CLOAK_KEEP_BROWSER_OPEN="False"

# ---- Browser Use ----
# Browser Use API Key: Saved in .env (BROWSER_USE_API_KEY), not written back config/*.py
BROWSER_USE_API_KEY=""
# Proxy country code: two-letter country code, such as jp/us/sg; works with the built-in Browser Use residential proxy
BROWSER_USE_PROXY_COUNTRY_CODE="jp"
# Use built-in proxy: True=connection parameters include proxyCountryCode; False=do not force the country proxy parameter
BROWSER_USE_USE_PROXY="True"
# Profile ID: Optional. When filled, the cookies/localStorage of the Browser Use profile are reused; leave empty for batches
BROWSER_USE_PROFILE_ID=""
# CDP address: default wss://connect.browser-use.com
BROWSER_USE_CDP_BASE="wss://connect.browser-use.com"
# Operation timeout (seconds): Playwright default operation timeout
BROWSER_USE_TIMEOUT="90"
# Fast mode: reduce extra Browser Use waits and humanize delays; recommended on, can be turned off when troubleshooting
BROWSER_USE_FAST_MODE="True"
# Timing log: print Browser Use per-stage timings: connect, open page, email, OTP, phone,callback
BROWSER_USE_LOG_TIMING="True"
# Keep remote session: when debugging, browser.close() may be skipped; default False
BROWSER_USE_KEEP_BROWSER_OPEN="False"
# Start URL: default https://chatgpt.com/auth/login
BROWSER_USE_START_URL="https://chatgpt.com/auth/login"

# ---- Skyvern ----
# Skyvern API Key: used to create Browser Session
SKYVERN_API_KEY=""
# API address: default https://api.skyvern.com
SKYVERN_API_BASE="https://api.skyvern.com"
# Browser Session timeout (minutes)
SKYVERN_BROWSER_SESSION_TIMEOUT="60"
# Optional: reuse Skyvern browser profile
SKYVERN_BROWSER_PROFILE_ID=""
# Optional: Skyvern proxy region; jp is automatically converted to RESIDENTIAL_JP
SKYVERN_PROXY_LOCATION=""
# Browser type: default stealth-chromium; options msedge/chrome/stealth-chromium
SKYVERN_BROWSER_TYPE="stealth-chromium"
# Whether to enable the ad blocker
SKYVERN_AD_BLOCKER="True"
# Whether to save the browser profile
SKYVERN_GENERATE_BROWSER_PROFILE="False"
# Keep the browser when debugging
SKYVERN_KEEP_BROWSER_OPEN="False"
# Start URL
SKYVERN_START_URL="https://chatgpt.com/auth/login"

# ---- RoxyBrowser ----
# Roxy API address: default http://127.0.0.1:50000; must be enabled in the Roxy app API settings
ROXY_API_BASE="http://127.0.0.1:50000"
# Roxy API Key: Saved in .env (ROXY_API_TOKEN), not written back to config/*.py
ROXY_API_TOKEN=""
# Roxy environment ID: the Roxy browser environment/Profile ID to open; if empty, tries to create a temporary environment
ROXY_PROFILE_ID=""
# Roxy workspace ID: required when creating one environment per account; submitted as workspaceId to the Roxy create-Profile endpoint
ROXY_WORKSPACE_ID="10910593635479552"
# Roxy project ID: obtained from project_details.projectId of /browser/workspace; submitted as projectId when creating a Profile
ROXY_PROJECT_ID="10910593710977024"
# Get teams endpoint: default /browser/workspace; when fetching teams/projects this path is tried first, then common compatible paths are tried automatically
ROXY_WORKSPACE_LIST_PATH="/browser/workspace"
# Open endpoint path: default /browser/open; adjust here if your Roxy version differs
ROXY_OPEN_PATH="/browser/open"
# Environment creation interval: minimum interval between adjacent /browser/create requests when multi-threaded, default 1.5 seconds; set to 0 to disable
ROXY_CREATE_INTERVAL="1.5"
# Headless start window: pass headless to /browser/open when opening a Roxy environment; False=show window, True=start headless
ROXY_OPEN_HEADLESS="False"
# Close endpoint path: default /browser/close
ROXY_CLOSE_PATH="/browser/close"
# Keep browser: can be enabled when debugging, the Roxy environment is not closed automatically after the task ends
ROXY_CREATE_RETRIES="3"
ROXY_CREATE_RETRY_DELAY="3"
ROXY_KEEP_BROWSER_OPEN="False"
# Roxy cross-Profile local static asset cache; enabled automatically when BROWSER_DATA_SAVER_MODE is on
ROXY_LOCAL_ASSET_CACHE_ENABLED="False"
ROXY_LOCAL_ASSET_CACHE_MODE="auto"
ROXY_LOCAL_ASSET_CACHE_DIR="./cache/roxy-assets"
ROXY_LOCAL_ASSET_CACHE_MAX_AGE="86400"
ROXY_LOCAL_ASSET_CACHE_MAX_ITEM_BYTES="26214400"
# One environment per account: force creating a new Roxy Profile for every account, close and delete it after use, and never reuse a fixed environment
ROXY_ONE_PROFILE_PER_ACCOUNT="True"
# Delete environment after run: in one-environment-per-account mode, after the task ends delete what was created in this round, i.e. the Roxy Profile
ROXY_DELETE_PROFILE_AFTER_RUN="True"
# Use proxy pool when creating environment: when creating a Roxy environment, randomly take one proxy from the Proxy Pool on the settings page and write it into Roxy proxyInfo
ROXY_CREATE_USE_PROXY_POOL="True"
# Proxy check channel: written to Roxy proxyInfo.checkChannel; if empty it is not passed, default IPRust.io
ROXY_PROXY_CHECK_CHANNEL="IPRust.io"
# Delete endpoint path: default /browser/delete; adjust if your Roxy version differs
ROXY_DELETE_PATH="/browser/delete"

# ---- CPA / Codex ----
# Codex authorization driver: protocol=original protocol authorization; roxy=use RoxyBrowser; cloak=use CloakBrowser; browser_use=use Browser Use Cloud; skyvern=use Skyvern; same_as_registration=follow the registration driver
CODEX_OAUTH_DRIVER="roxy"

# ---- RoxyBrowser ----
# Codex callback timeout: maximum seconds Roxy Codex OAuth waits for the localhost:1455 callback
ROXY_CODEX_CALLBACK_TIMEOUT="180"

# ---- Feature Switches ----
# Enable 2FA (TOTP): automatically set up a one-time passcode after registration completes (one more OTP email will be received)
ENABLE_2FA="True"
# 2FA proxy mode: saved=prefer the proxy saved with the account; pool=randomly assign from the proxy pool each time
TWOFA_PROXY_MODE="saved"
# 2FA maximum attempts for the re-authentication initiation stage (retry on 403/429/5xx/network errors)
TWOFA_REAUTH_MAX_ATTEMPTS=3
# 2FA base retry interval in seconds for re-authentication (exponential backoff by 1, 2, 4 times)
TWOFA_REAUTH_RETRY_DELAY=4
# 2FA background task concurrency (restart the service after changing)
TWOFA_WORKERS="4"
# 2FA background wait queue capacity
TWOFA_QUEUE_LIMIT="200"
# Enable Flow trigger: automatically call the internal Flow endpoint after successful registration (does not affect the registration result)
ENABLE_FLOW_TRIGGER="True"

# ---- Human Pacing ----
# Enable random pauses: add random waits between steps such as registration, OTP and authorization, closer to human pacing
ENABLE_HUMANIZE_DELAY="True"
# Pause factor: overall multiplier for random pauses; 1.0=default, 0.5=halved, 2.0=doubled
HUMANIZE_DELAY_FACTOR="1.0"

# ---- Email / OTP ----
# Auto take email + receive code: True=automatically take an email from the email pool and receive the OTP; False=manual mode: use REGISTER_EMAIL and enter the OTP by hand on the task page
USE_EMAIL_SERVICE="True"
# Manual registration email: required when USE_EMAIL_SERVICE=False. For example your outlook.com address; check the OTP in the webmail, then submit it on the task page
REGISTER_EMAIL=""
# Display name: leave empty to generate an English name automatically
REGISTER_NAME=""
# OTP max wait (seconds): maximum seconds to wait for the verification code email; failure on timeout
OTP_MAX_WAIT="90"
# OTP polling interval (seconds): how many seconds between checks for new email
OTP_POLL_INTERVAL="3"
# Email source: one or more, comma-separated, with fallback in order:outlook,generic_api,cloudflare_domain,cloudflare,gptmail,mailnest,cloudmail,remail
EMAIL_SOURCE="generic_api"
# Outlook fetch mode: auto=remote first, automatically switch to direct Graph when remote returns 402/DEPLOYMENT_DISABLED; direct=use only direct Microsoft Graph; remote=use only the remote service
OUTLOOK_FETCH_MODE=
# cloudflare_domain only: Email Routing forwarding domain, such as mydomain.com (unrelated to EMAIL_SOURCE=cloudflare)
EMAIL_DOMAIN=
# Only cloudflare_domain: the QQ mailbox that receives the Email Routing forwards, e.g. 123456@qq.com
QQ_EMAIL=
# cloudflare_domain only: QQ mailbox IMAP authorization code (not written back to config/*.py)
QQ_IMAP_PASSWORD=
# GPTMail API Key: required when EMAIL_SOURCE=gptmail is selected; the service address is fixed to https://mail.chatgpt.org.uk
GPTMAIL_API_KEY=

# Cloudflare Worker temporary email (when EMAIL_SOURCE contains cloudflare; different from cloudflare_domain/QQ IMAP)
# Worker API root address, for example https://mail.example.com (no extra trailing path)
CLOUDFLARE_API_BASE=
# Optional for anonymous; for admin mode fill in ADMIN_PASSWORD
CLOUDFLARE_API_KEY=
# none / bearer / x-api-key / x-admin-auth / query-key; recommended for admin: x-admin-auth
CLOUDFLARE_AUTH_MODE=
# Worker global password, injected into the request header x-custom-auth; leave empty if none
CLOUDFLARE_CUSTOM_AUTH=
# Create email path: default /api/new_address; commonly used for admin creation /admin/new_address
CLOUDFLARE_PATH_ACCOUNTS=
# Email list path: default /api/mails
CLOUDFLARE_PATH_MESSAGES=
# Domain list path: default /api/domains
CLOUDFLARE_PATH_DOMAINS=
# Token path: default /api/token (reserved for fallback)
CLOUDFLARE_PATH_TOKEN=
# Default receiving domains, comma-separated, for example mail.example.com; may be left empty to let the Worker decide
CLOUDFLARE_DEFAULT_DOMAINS=
# HTTP request timeout in seconds, default 20
CLOUDFLARE_REQUEST_TIMEOUT=
# admin random local-part length when creating, default 10
CLOUDFLARE_NAME_LENGTH=
# MailNest-MailNest-Maichao Outlook temporary email api key page https://mailnest.top/account
MAIL_NEST_API_KEY=
# MailNest project code: default chatgpt001
MAIL_NEST_PROJECT_CODE=
# CloudMail/Cloud Mail API address, e.g. https://mail.example.com
CLOUDMAIL_API_BASE=
# CloudMail admin email; after the account and password are filled in, saving settings automatically obtains CLOUDMAIL_AUTH_TOKEN
CLOUDMAIL_ADMIN_EMAIL=
# CloudMail login password
CLOUDMAIL_PASSWORD=
# CloudMail token generation endpoint path, default /api/public/genToken
CLOUDMAIL_TOKEN_PATH=
# CloudMail/Cloud Mail API Authorization Token
CLOUDMAIL_AUTH_TOKEN=
# CloudMail email domain list, one per line
CLOUDMAIL_DOMAINS=
# After generating a random email, whether to automatically call /api/public/addUser
CLOUDMAIL_AUTO_ADD_USER=
# Random email local-part length
CLOUDMAIL_RANDOM_LOCAL_LENGTH=
# Remail open API documentation:https://remail.aishop6.com/docs
# API root address; a documentation URL also works, the client strips it automatically /docs
REMAIL_API_BASE="https://remail.aishop6.com"
# Remail console-generated rk- prefixed API Key
REMAIL_API_KEY=""
# Remail projectId in the project list (for the ChatGPT/OpenAI verification code project)
REMAIL_PROJECT_ID="2"
# Order email suffix, default outlook.com
REMAIL_EMAIL_SUFFIX="icloud.com"
# code=short-term code receiving; purchase=long-term purchase (repeat receiving allowed), default purchase
REMAIL_SERVICE_MODE="purchase"
# private_first or public_only, default public_only
REMAIL_SUPPLY_POLICY="public_only"
# Maximum seconds to wait for the service token to be filled in after ordering, default 30
REMAIL_ORDER_WAIT_SECONDS="30"
# HTTP request timeout in seconds, default 20
REMAIL_REQUEST_TIMEOUT="20"

# ---- Browser Profile ----
# Region profile: should match the proxy exit region; options jp/cn/us/sg. The current local proxy was measured as Tokyo, Japan; recommended jp
BROWSER_LOCALE_PROFILE="jp"
# Auto profile by exit IP: when enabled, each BrowserSession picks language/timezone from the current proxy exit IP; falls back to the region profile on failure
AUTO_BROWSER_LOCALE_FROM_IP="True"
# IP Geolocation timeout (seconds): single-request timeout of the exit IP geo information endpoint; falls back automatically on failure, without affecting registration
IP_GEO_TIMEOUT="6.0"

# ---- Proxy pool ----
# Proxy pool (one per line): one proxy URL per line, blank lines are ignored; if empty, no proxy is used
PROXY_POOL=""
# Plan check network mode: auto=use the local proxy if available, connect directly if it is not listening; proxy=force proxy; direct=force direct connection
PLAN_CHECK_PROXY_MODE="auto"
# Plan check dedicated proxy: when empty, auto/proxy picks from the proxy pool; may contain authentication info
PLAN_CHECK_PROXY=""
# Plan check local upstream proxy: connect to the dynamic proxy above through a local proxy, forming a proxy chain
PLAN_CHECK_UPSTREAM_PROXY="http://127.0.0.1:7897"

# ---- CPA / Codex ----
# Authorization URL source: cpa=generated by the CPA management endpoint; local=legacy locally generated PKCE authorization URL
CODEX_AUTH_URL_SOURCE="local"
# CPA management URL: for example http://localhost:8317/admin/oauth; the program takes the origin and calls /v0/management/*
CPA_MANAGEMENT_URL=
# Management key: saved in .env (CPA_MANAGEMENT_KEY), not written back config/*.py
CPA_MANAGEMENT_KEY=
# CPA timeout (seconds): timeout for requests to the CPA management endpoint
CPA_REQUEST_TIMEOUT=
# Save CPA receipt: when CPA does not return a complete authorization file, still save a local callback submission record
CPA_SAVE_CALLBACK_RECEIPT=

# ---- Code-Receiving Platform ----
# SMS channel: grizzly / l / h; h uses the local number-taking service defined in H_API.md
SMS_PROVIDER="smsbower"
# Country code: the country passed to the code-receiving platform; common for GrizzlySMS: US=187; for the L/H channels fill in per the local admin settings
SMS_COUNTRY="187"
# Service/project code: used as service for GrizzlySMS/L; the H channel can reuse it as projectId
SMS_SERVICE="dr"
# Number switch retries: when a number receives no SMS or is rejected by OpenAI, switch to the next number; maximum number of retries
SMS_MAX_RETRIES="10"
# Wait for SMS per number (seconds): maximum seconds a single number waits for the SMS to arrive; switch number on timeout
SMS_CODE_WAIT="120"
# GrizzlySMS API key: saved in .env (SMS_API_KEY), not written back to config/*.py
SMS_API_KEY=
# H API address: base address of the H number-taking service, for example http://localhost:8788
H_API_BASE=
# H authorization code: saved in .env (H_ADMIN_AUTH_CODE), not written back config/*.py
H_ADMIN_AUTH_CODE=
# H number prefix: fill in when the number returned by H has no country code, for example fill in 1 for a 10-digit local US number; leave empty to not add one
H_PHONE_PREFIX=
# H take-number mode: reusable=prefer reusing numbers; new=take a new number each time (calls /api/admin/h/take-phone)
H_PHONE_ACQUIRE_MODE=
# L API address: base address of the L number-taking service, for example http://localhost:8788
L_API_BASE=
# L authorization code: saved in .env (L_ADMIN_AUTH_CODE), not written back config/*.py
L_ADMIN_AUTH_CODE=
# L number prefix: fill in when the number returned by L has no country code, for example fill in 1 for a 10-digit local US number; leave empty to not add one
L_PHONE_PREFIX=

# ---- updated by WebUI / config.env_loader ----
AUTO_PLAN_CHECK_AFTER_REGISTER="False"
BROWSER_USE_SESSION_TIMEOUT="240"
ROXY_RANDOM_OS_ON_CREATE="True"
ROXY_RANDOM_PROFILE_NAME_ON_CREATE="True"
ROXY_RANDOM_OS_CHOICES="Windows,macOS"
ROXY_PROFILE_NAME_PREFIX="rb"
ENABLE_HUMANIZE_BROWSER_ACTIONS="True"
PLAN_CHECK_TIMEOUT="15.0"
PLAN_CHECK_MAX_ATTEMPTS="2"
PLAN_CHECK_RETRY_DELAY="1.5"
PLAN_CHECK_REGISTRATION_RECHECK_DELAY="2.0"
PLAN_CHECK_WORKERS="3"
PLAN_CHECK_QUEUE_LIMIT="500"
PLAN_CHECK_MIN_INTERVAL="0.4"
PLAN_CHECK_JITTER="0.3"
